# ============================================================
# AI Software Agent - environment variables
# Copy to .env and fill in. Never commit .env to git.
# ============================================================

# ---- LLM provider ----
# One of: anthropic | openai | google
LLM_PROVIDER=anthropic

# Model name for the provider chosen above.
# Check your provider's docs for the exact model string.
LLM_MODEL=claude-sonnet-5-5

# ---- API keys (fill in only the one you use) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=