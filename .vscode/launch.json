{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Agent: Job-Pilot",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--repo", "../Job-Pilot/"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}" }
    }
  ]
}